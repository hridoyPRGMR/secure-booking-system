# Secrets and environment-specific values for SecureBooking.Api (production).
# On Azure App Service, set these as Application settings. "__" maps to ":" in config keys.
# Do NOT commit a real .env file. Non-secret defaults belong in appsettings.json.

ASPNETCORE_ENVIRONMENT=Production

# --- Secrets ---
ConnectionStrings__DefaultConnection=Host=<server>.postgres.database.azure.com;Port=5432;Database=securebooking;Username=<user>;Password=<password>;SSL Mode=Require
# Generate with: openssl rand -base64 64
JwtSettings__Secret=<long-random-secret>

# --- Environment-specific (not secret) ---
Cors__AllowedOrigins__0=https://<your-frontend-domain>
AllowedHosts=<your-api-domain>

# Optional overrides. Migrations run on startup only in Development; production
# migrates in the deploy-backend workflow. (Defaults: MigrateOnStartup=false, SeedData=false)
# Database__MigrateOnStartup=false
# SeedData__Enabled=false

# --- Initial administrator (created on startup if no user with this email exists) ---
# No default admin is seeded anymore; set these for the first deploy, then log in and rotate/remove.
AdminSeed__Email=<admin-email>
AdminSeed__Password=<strong-password>
